---
import Base from '../layouts/Base.astro';

const generalCoordinators = [
  { name: 'Arshad Ahmed', email: 'arshad.ahmed@students.iiserpune.ac.in' },
  { name: 'Niti Sanjay Torphe', email: 'niti.sanjaytorphe@students.iiserpune.ac.in' },
  { name: 'Piyush Kolhe', email: 'piyush.vinitkolhe@students.iiserpune.ac.in' },
];

const programmeCoordinators = [
  { programme: 'Abhyasika', people: ['Himanshu Vinod Chahande', 'Yashwanth Ganapathineni'] },
  { programme: 'Apeksha', people: ['Aakash Gupta', 'Kumar Hitesh', 'Kajal Singh']},
  { programme: 'Mindspark', people: ['Deepti Rani Singh', 'Denzel D George', 'Kuhu Bhatt'] },
  { programme: 'Paalvi', people: ['Prajwal Vikas Mangal', 'Vignesh Lagduwan']},
  { programme: 'Pahal', people: ['Sanvi Moreshwar Gurpude', 'Varad Lingampallee', 'Shailendra Pratap Singh']},
  {programme: 'Resource Team', people: ['Komal', 'Nayana Prakash Suvarnakar']},
  { programme: 'Science Nurture Program', people: ['Atharv Mishra', 'Ayesha Jabin', 'Saptham'] },
  { programme: 'Spread The Smile', people: ['Aditya Pathak', 'Arnav Khadkikar', 'Vishal Kumar'] }
];

const coreTeam = [
  'Pranshu Nemani (Finance Coordinator)',
  'Ekamjot Singh Madan',
  'Yojit Kumar',
  'Keyur Kulkarni',
  'Arpita Ladda',
  'Hriday Sharma',
  'Lakshmi Priya M',
  'Pushkar Ghosh',
  'Ruturak Subhash Alornekar',
  'Sanskruti Nalawade',
  'Sreya Pradeep',
  'Vihan Ashra'
];
---

<Base title="Our Team" description="The coordinators and core team running Disha, IISER Pune.">
  <div class="page-hero">
    <div class="container">
      <h1>Our Team</h1>
      <p>The volunteers coordinating Disha's programmes this academic year.</p>
    </div>
  </div>

  <div class="container section">
    <h2>General Coordinators</h2>
    <div class="grid team-grid">
      {generalCoordinators.map((p) => (
        <div class="card person">
          <h3>{p.name}</h3>
          <a href={`mailto:${p.email}`}>{p.email}</a>
        </div>
      ))}
    </div>

    <h2>Programme Coordinators</h2>
    <div class="grid team-grid">
      {programmeCoordinators.map((g) => (
        <div class="card person">
          <h3>{g.programme}</h3>
          <ul>
            {g.people.map((name) => <li>{name}</li>)}
          </ul>
        </div>
      ))}
    </div>

    <h2>Core Team</h2>
    <div class="card person core">
      <ul class="core-list">
        {coreTeam.map((name) => <li>{name}</li>)}
      </ul>
    </div>
  </div>
</Base>

<style>
  h2 { margin-block: 2rem 1rem; font-size: 1.5rem; }
  h2:first-of-type { margin-top: 0; }
  .person { padding: 1.3rem 1.5rem; }
  .person h3 { font-size: 1.15rem; margin-bottom: 0.4rem; color: var(--terracotta); }
  .person a { font-size: 0.92rem; word-break: break-all; }
  .person ul { list-style: none; padding: 0; }
  .person li + li { margin-top: 0.3rem; }
  .core-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.5rem 1.5rem;
  }
</style>
