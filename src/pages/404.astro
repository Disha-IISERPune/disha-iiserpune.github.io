---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <div class="container section notfound">
    <img src="/images/cropped-disha-logo-2.png" alt="" width="120" />
    <h1>Page not found</h1>
    <p>The page you're looking for doesn't exist — maybe it moved during our migration from WordPress.</p>
    <p>
      <a class="btn btn--primary" href="/">Go home</a>
      <a class="btn btn--ghost" href="/wiki">Browse the wiki</a>
    </p>
  </div>
</Base>

<style>
  .notfound { text-align: center; padding-block: 6rem; }
  .notfound img { margin-inline: auto; margin-bottom: 1.5rem; }
  .notfound p { margin-top: 1rem; color: var(--muted); }
  .notfound .btn { margin: 0.3rem; }
</style>
