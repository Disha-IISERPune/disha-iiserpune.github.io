---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const date = post.data.date.toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' });

// first non-image paragraph as an excerpt
const excerpt = (post.body ?? '')
  .split('\n')
  .map((l) => l.trim())
  .filter((l) => l && !l.startsWith('!') && !l.startsWith('#') && !l.startsWith('[![') && !l.startsWith('* * *') && !l.startsWith('<'))
  .join(' ')
  .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
  .replace(/[*_`>#]/g, '')
  .slice(0, 180);
---

<a class="card post-card" href={`/blog/${post.id}`}>
  <p class="meta">{date}</p>
  <h3>{post.data.title}</h3>
  {excerpt && <p class="excerpt">{excerpt}…</p>}
</a>

<style>
  .post-card { padding: 1.2rem 1.35rem 1.4rem; }
  .post-card h3 { font-size: 1.18rem; margin-top: 0.3rem; }
  .excerpt { color: var(--muted); font-size: 0.95rem; margin-top: 0.5rem; }
</style>
