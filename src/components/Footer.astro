---
import WarliDivider from './WarliDivider.astro';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-warli"><WarliDivider /></div>
  <div class="container footer-grid">
    <div class="footer-about">
      <div class="footer-brand">
        <img src="/images/cropped-disha-logo-2.png" alt="Disha logo" width="56" height="56" />
        <div>
          <p class="footer-name">Disha <span>दिशा</span></p>
          <p class="footer-tag">A voluntary organisation of IISER Pune students for social cause — since 2010.</p>
        </div>
      </div>
    </div>

    <nav class="footer-links" aria-label="Footer">
      <p class="footer-heading">Explore</p>
      <ul>
        <li><a href="/about">About Us</a></li>
        <li><a href="/programs">Programmes</a></li>
        <li><a href="/blog">Blog</a></li>
        <li><a href="/wiki">Wiki</a></li>
        <li><a href="/wiki/constitution">Constitution</a></li>
        <li><a href="/programs/pahal">Pahal — Newsletter</a></li>
      </ul>
    </nav>

    <div class="footer-contact">
      <p class="footer-heading">Reach Us</p>
      <p>
        IISER Pune, Dr Homi Bhabha Road,<br />
        Pashan, Pune – 411008
      </p>
      <p><a href="mailto:disha@sac.iiserpune.ac.in">disha@sac.iiserpune.ac.in</a></p>
      <p class="footer-social">
        <a href="https://www.instagram.com/disha.iiserpune/" target="_blank" rel="noopener">Instagram</a> ·
        <a href="https://www.facebook.com/iiserpunedisha/" target="_blank" rel="noopener">Facebook</a> ·
        <a href="https://iiserpunedisha.wordpress.com/" target="_blank" rel="noopener">Old Website</a>
      </p>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p>© {year} Disha, IISER Pune · Thinking beyond self, working at the grassroots.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--footer-bg);
    color: var(--footer-text);
    margin-top: auto;
  }
  .footer-warli {
    color: var(--ochre);
    padding: 1.2rem 0 0.4rem;
    max-width: 1120px;
    margin-inline: auto;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.2fr;
    gap: 2.5rem;
    padding-block: 1.5rem 2.5rem;
  }
  .footer-brand { display: flex; gap: 1rem; align-items: flex-start; }
  .footer-brand img { border-radius: 50%; background: #fff; flex-shrink: 0; }
  .footer-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
    color: #fff;
  }
  .footer-name span { color: var(--ochre); }
  .footer-tag { opacity: 0.8; font-size: 0.95rem; margin-top: 0.2rem; }
  .footer-heading {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.85rem;
    color: var(--ochre);
    margin-bottom: 0.7rem;
  }
  .footer-links ul { list-style: none; padding: 0; }
  .footer-links li + li { margin-top: 0.35rem; }
  .site-footer a { color: var(--footer-text); text-decoration-color: color-mix(in srgb, currentColor 35%, transparent); }
  .site-footer a:hover { color: #fff; }
  .footer-contact p + p { margin-top: 0.5rem; }
  .footer-social { margin-top: 0.8rem; }
  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-block: 1rem;
    font-size: 0.88rem;
    opacity: 0.75;
  }
  @media (max-width: 760px) {
    .footer-grid { grid-template-columns: 1fr; gap: 1.8rem; }
  }
</style>
