---
import type { CollectionEntry } from 'astro:content';

interface Props {
  program: CollectionEntry<'programs'>;
}

const { program } = Astro.props;
const { title, summary, image, icon, active } = program.data;
---

<a class="card program-card" href={`/programs/${program.id}`}>
  {image && (
    <div class="program-img">
      <img src={image} alt="" loading="lazy" />
    </div>
  )}
  <div class="program-body">
    <h3>{icon && <span class="program-icon" aria-hidden="true">{icon}</span>} {title}</h3>
    {!active && <span class="badge">Past programme</span>}
    {summary && <p>{summary}</p>}
    <span class="program-more">Learn more →</span>
  </div>
</a>

<style>
  .program-img {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--sand);
  }
  .program-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .program-card:hover .program-img img { transform: scale(1.04); }
  .program-body { padding: 1.1rem 1.25rem 1.3rem; }
  .program-body h3 { font-size: 1.25rem; }
  .program-icon { margin-right: 0.15rem; }
  .program-body p { color: var(--muted); font-size: 0.97rem; margin-top: 0.45rem; }
  .badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--book-brown);
    background: var(--sand-deep);
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
    margin-top: 0.4rem;
  }
  .program-more {
    display: inline-block;
    margin-top: 0.7rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--terracotta);
  }
</style>
