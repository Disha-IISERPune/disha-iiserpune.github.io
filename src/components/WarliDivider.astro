---
// A strip of dancing Warli figures holding hands — echoes the Disha logo.
// Colors follow `currentColor`; set the color on the wrapper where used.
const count = 24;
---

<div class="warli-divider" aria-hidden="true">
  <svg viewBox={`0 0 ${count * 48} 64`} preserveAspectRatio="xMidYMid meet" width="100%" height="40">
    <defs>
      <g id="warli-figure" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <circle cx="24" cy="9" r="5.5" fill="currentColor" stroke="none"></circle>
        <path d="M13 18 L35 18 L24 35 Z" fill="currentColor" stroke="none"></path>
        <path d="M24 35 L14 55 L34 55 Z" fill="currentColor" stroke="none"></path>
        <path d="M14 19 L0 9" fill="none"></path>
        <path d="M34 19 L48 9" fill="none"></path>
        <path d="M18 55 L15 63" fill="none"></path>
        <path d="M30 55 L33 63" fill="none"></path>
      </g>
    </defs>
    {Array.from({ length: count }, (_, i) => (
      <use href="#warli-figure" x={i * 48} y="0" />
    ))}
  </svg>
</div>

<style>
  .warli-divider {
    overflow: hidden;
    line-height: 0;
    opacity: 0.85;
  }
</style>
